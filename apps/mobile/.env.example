# Supabase connection for the mobile app.
# EXPO_PUBLIC_* vars are embedded in the app bundle. The publishable key only
# grants access allowed by Row Level Security. NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://vpklztxqkvqmmzsxfqgp.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

