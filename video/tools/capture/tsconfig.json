{
  // Type-check the fake backend and the harness glue without building anything:
  //   pnpm --ignore-workspace exec tsc -p tools/capture     (from video/)
  // The app itself is checked by its own tsconfig; here it is only a source of types.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["fake/**/*.ts", "fake/**/*.js"]
}
